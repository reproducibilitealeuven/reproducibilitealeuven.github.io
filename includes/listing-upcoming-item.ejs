```{=html}
<div class="list grid quarto-listing-cols-3">
<% for (const item of items) { %>
  <div class="g-col-1" <%= metadataAttrs(item) %>>
    <div class="quarto-grid-item card h-100 card-center">
      <% if (item.image) { %>
      <p class="card-img-top">
        <img loading="lazy" src="<%- item.image %>" class="thumbnail-image card-img" style="height: 200px;" />
      </p>
      <% } %>
      <div class="card-body post-contents">
        <% if (item.title) { %>
        <h5 class="no-anchor card-title listing-title"><%= item.title %></h5>
        <% } %>
        <% if (item.description) { %>
        <div class="card-text listing-description delink session-description is-collapsed" role="button" tabindex="0" aria-expanded="false" aria-label="Show full description"><%= item.description %></div>
        <% } %>
        <% if (item.date) { %>
        <div class="card-attribution card-text-small end">
          <div class="listing-date"><%= item.date %></div>
        </div>
        <% } %>
        <% if (item.location) { %>
        <div class="listing-location-inline">
          <% if (item["location-link"] || item.location_link || item["location-url"] || item.location_url) { %>
          <a href="<%- item['location-link'] || item.location_link || item['location-url'] || item.location_url %>" target="_blank" rel="noopener"><%= item.location %></a>
          <% } else { %>
          <span><%= item.location %></span>
          <% } %>
        </div>
        <% } %>
        <% if (item.author) { %>
        <div class="listing-author-inline"><%= item.author %></div>
        <% } %>
        <% if (item.path) { %>
        <div class="mt-3 session-register-wrap">
          <a href="<%- item.path %>" class="btn btn-primary session-register-btn" target="_blank" rel="noopener">Register</a>
        </div>
        <% } %>
      </div>
    </div>
  </div>
<% } %>
</div>

<script>
(() => {
  if (window.__upcomingSessionsDescriptionToggleInit) return;
  window.__upcomingSessionsDescriptionToggleInit = true;

  const selector = "#listing-upcoming-sessions .session-description";

  const toggleDescription = (el) => {
    const expanded = el.classList.toggle("is-expanded");
    el.classList.toggle("is-collapsed", !expanded);
    el.setAttribute("aria-expanded", expanded ? "true" : "false");
    el.setAttribute("aria-label", expanded ? "Collapse description" : "Show full description");
  };

  document.addEventListener("click", (event) => {
    const description = event.target.closest(selector);
    if (!description) return;
    toggleDescription(description);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" && event.key !== " ") return;
    const description = event.target.closest(selector);
    if (!description) return;
    event.preventDefault();
    toggleDescription(description);
  });
})();
</script>
```
